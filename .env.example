GATEWAY_API_KEY=
# Wallet fund-flow: the wallet's most recent ERC-20 transfers, fetched via Alchemy's
# alchemy_getAssetTransfers (see src/tokenApi/ethersFallback.ts) — must be an Alchemy endpoint.
# ETHERS_RPC_URL_<NETWORK> (e.g. ETHERS_RPC_URL_MATIC) overrides the generic URL for a specific
# network.
ETHERS_RPC_URL=
# Optional — how many most-recent transfers to fetch per direction (sent/received). Default: 5.
ETHERS_MAX_TRANSFERS=5
GEMINI_API_KEY=
# Separate API key (ideally a different Google account/project) for the "lending" subgraph lookup
# (see src/subgraph/nlAgent.ts) — its own free-tier quota bucket, so it doesn't compete with
# GEMINI_API_KEY's "swaps" lookup or the risk-analysis pass.
GEMINI_API_KEY_LENDING=
# Optional — defaults to gemini-3.5-flash. Gemini's free-tier request quota is tracked per model,
# so picking a different model here gets its own separate daily quota bucket.
GEMINI_MODEL=

# ENSv2 wallet-naming (Sepolia) — see README "ENS wallet naming" section
SEPOLIA_RPC_URL=
ENS_PRIVATE_KEY=
PARENT_ENS_NAME=
PARENT_SUBREGISTRY_ADDRESS=
PARENT_RESOLVER_ADDRESS=
