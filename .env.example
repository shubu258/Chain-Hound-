# The Graph Gateway API key, used to authenticate against the Subgraph MCP server.
GATEWAY_API_KEY=

# Optional override for the Subgraph MCP SSE endpoint.
# SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse

# Port the HTTP API listens on (default 3000).
# PORT=3000

# Chain label echoed back in wallet data responses (not enforced against search results —
# see the Chain comment in src/subgraph/dataRetrival.ts).
# DEFAULT_CHAIN=mainnet

# Example wallet address for testing POST /api/wallet:
# 0xFEEEEEE44046c3f61a8CC081E0918eF0de0a7ffC
